; =============================================================================
; project.godot - Configuración del proyecto body-shan
; =============================================================================
; Archivo de configuración del motor. Normalmente Godot lo genera y lo
; modifica desde el editor; aquí solo se documentan las claves importantes.
; Los comentarios en este archivo empiezan por ";".
;
; Formato:
;   [seccion]        -> agrupa ajustes
;   clave=valor      -> asigna un valor al ajuste
; =============================================================================

config_version=5

[application]

; Nombre que aparece en el gestor de proyectos y en la ventana del juego.
config/name="body-shan"
; Escena que se ejecuta al pulsar F5 (referenciada por su UID interno).
run/main_scene="uid://cg5kwwg0csvo3"
; Versión de Godot (4.7) y plataforma de destino (Mobile).
config/features=PackedStringArray("4.7", "Mobile")
; Icono del proyecto.
config/icon="res://icon.svg"

[display]

; Escala la interfaz de forma proporcional al tamaño de la ventana.
window/stretch/mode="canvas_items"
; Mantiene la proporción de la imagen al estirar la ventana.
window/stretch/aspect="expand"

[input]

; -----------------------------------------------------------------------------
; MAPA DE ENTRADA (Input Map)
; -----------------------------------------------------------------------------
; Cada acción agrupa una o más teclas/eventos. Los scripts usan el nombre de la
; acción (por ejemplo "move_forward") y no la tecla concreta, de modo que se
; pueden cambiar los controles sin tocar el código.
;
; "physical_keycode": código de la tecla según su posición física en el teclado
; (así WASD funciona igual en distribuciones no inglesas).
; "deadzone": margen mínimo para considerar que un eje analógico se ha movido.
; -----------------------------------------------------------------------------

; Avanzar: W y flecha arriba (87 / 4194320).
move_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194320,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
; Retroceder: S y flecha abajo (83 / 4194322).
move_back={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":83,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194322,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
; Izquierda: A y flecha izquierda (65 / 4194319).
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194319,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
; Derecha: D y flecha derecha (68 / 4194321).
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":68,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194321,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
; Saltar: barra espaciadora (32).
jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":32,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
; Correr: Shift (4194325).
sprint={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194325,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[physics]

; Motor de física 3D usado por el proyecto.
3d/physics_engine="Jolt Physics"

[rendering]

; API gráfica de Windows (Direct3D 12).
rendering_device/driver.windows="d3d12"
; Renderizador Mobile: más ligero que Forward+ y pensado para móviles o GPUs
; integradas, suficiente para este mapa.
renderer/rendering_method="mobile"
